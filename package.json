{
  "name": "@brajkowski/qr-code",
  "version": "0.0.0-semantically-released",
  "description": "Zero-dependency QR code generator (PNG and SVG) for Node.",
  "keywords": [
    "qr",
    "qrcode",
    "qr-code",
    "png",
    "svg",
    "generator",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Brandon Rajkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brajkowski/qr-code.git"
  },
  "homepage": "https://github.com/brajkowski/qr-code#readme",
  "bugs": "https://github.com/brajkowski/qr-code/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "fixtures": "node test/fixtures/generate.mjs"
  },
  "devDependencies": {
    "@nuintun/qrcode": "^5.0.3",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "nayuki-qr-code-generator": "^1.8.0",
    "typescript": "^7.0.2"
  }
}
